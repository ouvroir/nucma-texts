<?xml version="1.0" encoding="UTF-8"?>
<project>
    <meta>
        <filters directoryPatterns="" filePatterns="\Qnucma-texts.xpr\E" positiveFilePatterns="" showHiddenFiles="false"/>
        <options>
            <serialized xml:space="preserve">
                <serializableOrderedMap>
                    <entry>
                        <String>additional.frameworks.directories</String>
                        <String-array>
                            <String>${pd}/oxygen/frameworks</String>
                        </String-array>
                    </entry>
                    <entry>
                        <String>document.types</String>
                        <documentTypeDescriptor-array/>
                    </entry>
                    <entry>
                        <String>enable.project.master.files.support</String>
                        <Boolean>true</Boolean>
                    </entry>
                    <entry>
                        <String>key.editor.document.type.association.option.pane</String>
                        <Boolean>true</Boolean>
                    </entry>
                    <entry>
                        <String>key.editor.document.type.custom.locations.option.pane</String>
                        <Boolean>true</Boolean>
                    </entry>
                </serializableOrderedMap>
            </serialized>
        </options>
    </meta>
    <projectTree name="nucma-texts.xpr">
        <folder masterFiles="true" name="Main Files">
            <file name="en/_corpus.xml"/>
            <file name="fr/_corpus.xml"/>
        </folder>
        <folder path="."/>
    </projectTree>
</project>