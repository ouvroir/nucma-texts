<?xml version="1.0" encoding="UTF-8"?>
<project>
    <meta>
        <filters directoryPatterns="" filePatterns="\Qnucma-texts.xpr\E" positiveFilePatterns="" showHiddenFiles="false"/>
        <options>
            <serialized xml:space="preserve">
                <serializableOrderedMap>
                    <entry>
                        <String>additional.frameworks.directories</String>
                        <String-array>
                            <String>${pd}/oxygen/frameworks</String>
                        </String-array>
                    </entry>
                    <entry>
                        <String>document.types</String>
                        <documentTypeDescriptor-array/>
                    </entry>
                    <entry>
                        <String>enable.project.master.files.support</String>
                        <Boolean>true</Boolean>
                    </entry>
                    <entry>
                        <String>key.editor.document.type.association.option.pane</String>
                        <Boolean>true</Boolean>
                    </entry>
                    <entry>
                        <String>key.editor.document.type.custom.locations.option.pane</String>
                        <Boolean>true</Boolean>
                    </entry>
                    <entry>
                        <String>validation.scenario.associations</String>
                        <scenarioAssociation-array>
                            <scenarioAssociation>
                                <field name="url">
                                    <String>fr/acquisition/garde-partagee.xml</String>
                                </field>
                                <field name="scenarioIds">
                                    <list>
                                        <String>NUCMA entrées</String>
                                        <String>NUCMA quality</String>
                                    </list>
                                </field>
                                <field name="scenarioTypes">
                                    <list>
                                        <String>Validation_scenario</String>
                                        <String>Validation_scenario</String>
                                    </list>
                                </field>
                                <field name="scenarioStorageLocations">
                                    <list>
                                        <Byte>2</Byte>
                                        <Byte>2</Byte>
                                    </list>
                                </field>
                            </scenarioAssociation>
                        </scenarioAssociation-array>
                    </entry>
                    <entry>
                        <String>validation.scenarios</String>
                        <validationScenario-array>
                            <validationScenario>
                                <field name="pairs">
                                    <list>
                                        <validationUnit>
                                            <field name="validationType">
                                                <validationUnitType>
                                                    <field name="validationInputType">
                                                        <String>text/xml</String>
                                                    </field>
                                                </validationUnitType>
                                            </field>
                                            <field name="url">
                                                <String>${currentFileURL}</String>
                                            </field>
                                            <field name="validationEngine">
                                                <validationEngine>
                                                    <field name="engineType">
                                                        <String>&lt;Default engine></String>
                                                    </field>
                                                    <field name="allowsAutomaticValidation">
                                                        <Boolean>true</Boolean>
                                                    </field>
                                                </validationEngine>
                                            </field>
                                            <field name="allowAutomaticValidation">
                                                <Boolean>true</Boolean>
                                            </field>
                                            <field name="extensions">
                                                <null/>
                                            </field>
                                            <field name="validationSchema">
                                                <validationUnitSchema>
                                                    <field name="dtdSchemaPublicID">
                                                        <null/>
                                                    </field>
                                                    <field name="schematronPhase">
                                                        <null/>
                                                    </field>
                                                    <field name="type">
                                                        <Integer>4</Integer>
                                                    </field>
                                                    <field name="uri">
                                                        <String>../../schemas/nucma-text.rng</String>
                                                    </field>
                                                </validationUnitSchema>
                                            </field>
                                            <field name="validationAdvancedSettings">
                                                <null/>
                                            </field>
                                        </validationUnit>
                                    </list>
                                </field>
                                <field name="type">
                                    <String>Validation_scenario</String>
                                </field>
                                <field name="name">
                                    <String>NUCMA entrées</String>
                                </field>
                            </validationScenario>
                            <validationScenario>
                                <field name="pairs">
                                    <list>
                                        <validationUnit>
                                            <field name="validationType">
                                                <validationUnitType>
                                                    <field name="validationInputType">
                                                        <String>text/xml</String>
                                                    </field>
                                                </validationUnitType>
                                            </field>
                                            <field name="url">
                                                <String>${currentFileURL}</String>
                                            </field>
                                            <field name="validationEngine">
                                                <validationEngine>
                                                    <field name="engineType">
                                                        <String>&lt;Default engine></String>
                                                    </field>
                                                    <field name="allowsAutomaticValidation">
                                                        <Boolean>true</Boolean>
                                                    </field>
                                                </validationEngine>
                                            </field>
                                            <field name="allowAutomaticValidation">
                                                <Boolean>true</Boolean>
                                            </field>
                                            <field name="extensions">
                                                <null/>
                                            </field>
                                            <field name="validationSchema">
                                                <validationUnitSchema>
                                                    <field name="dtdSchemaPublicID">
                                                        <null/>
                                                    </field>
                                                    <field name="schematronPhase">
                                                        <null/>
                                                    </field>
                                                    <field name="type">
                                                        <Integer>7</Integer>
                                                    </field>
                                                    <field name="uri">
                                                        <String>../../schemas/nucma-quality.sch</String>
                                                    </field>
                                                </validationUnitSchema>
                                            </field>
                                            <field name="validationAdvancedSettings">
                                                <null/>
                                            </field>
                                        </validationUnit>
                                    </list>
                                </field>
                                <field name="type">
                                    <String>Validation_scenario</String>
                                </field>
                                <field name="name">
                                    <String>NUCMA quality</String>
                                </field>
                            </validationScenario>
                        </validationScenario-array>
                    </entry>
                </serializableOrderedMap>
            </serialized>
        </options>
    </meta>
    <projectTree name="nucma-texts.xpr">
        <folder masterFiles="true" name="Main Files">
            <file name="en/_corpus.xml"/>
            <file name="fr/_corpus.xml"/>
        </folder>
        <folder path="."/>
    </projectTree>
</project>