        </availability>
      </publicationStmt>
      <seriesStmt>
        <title xml:lang="fr" type="main">NUCMA</title>
        <title xml:lang="fr" type="sub">L’encyclopédie des Nouveaux usages des collections dans les musées d’art</title>
        <title xml:lang="en" type="main">NUCMA</title>
