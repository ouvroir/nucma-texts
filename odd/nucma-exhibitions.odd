<?xml version="1.0" encoding="UTF-8"?>
<?xml-model href="http://www.tei-c.org/release/xml/tei/custom/schema/relaxng/tei_odds.rng" type="application/xml" schematypens="http://relaxng.org/ns/structure/1.0"?>
<TEI xmlns="http://www.tei-c.org/ns/1.0" xml:lang="fr">
  <teiHeader>
    <fileDesc>
      <titleStmt>
        <title>NUCMA : schéma du référentiel des expositions</title>
        <principal ref="#ECD">
          <persName><forename>Emmanuel</forename> <surname>Château-Dutier</surname></persName>
          <affiliation>Université de Montréal</affiliation>
        </principal>
      </titleStmt>
      <publicationStmt>
        <publisher xml:lang="fr">Groupe de recherche et de réflexion CIÉCO</publisher>
        <publisher xml:lang="en">CIÉCO Research and Inquiry Group</publisher>
        <availability>
          <licence target="https://creativecommons.org/licenses/by/4.0/">
            <p>Ce contenu est mis à disposition sous licence Creative Commons Attribution 4.0</p>
          </licence>
        </availability>
      </publicationStmt>
      <sourceDesc>
        <p>Fichier nativement numérique</p>
      </sourceDesc>
    </fileDesc>
    <revisionDesc>
      <change when="2026-10-04" resp="#ECD">Création</change>
    </revisionDesc>
  </teiHeader>
  <text>
    <body>
      <div>
        <head>Référentiel des expositions</head>
        <p>Ce schéma contrôle <code>meta/exhibitions.xml</code>. Il s’appuie sur l’étage
          commun du projet (<code>nucma-common.odd</code>) et y ajoute la liste des
          événements, reprise de la TEI. Première version, souple : une exposition réunit son
          titre (<gi>eventName</gi>), son lieu (<gi>place</gi> : institution, ville, pays), ses
          dates et ses identifiants, sans ordre imposé.</p>
        <schemaSpec ident="nucma-exhibitions" start="TEI" source="nucma-common.compiled.odd">
          <moduleRef key="tei"/>
          <moduleRef key="header" except="title"/>
          <moduleRef key="core"/>
          <moduleRef key="textstructure"/>
          <moduleRef key="linking"/>
          <moduleRef key="namesdates"/>
          <moduleRef key="verse"/>
          <moduleRef key="figures"/>
          <moduleRef key="tagdocs"/>
          <moduleRef key="dictionaries"/>
          <!-- classes des événements et des lieux, absentes de Commons Publishing -->
          <classSpec ident="model.eventLike" type="model" mode="add"/>
          <classSpec ident="model.placeLike" type="model" mode="add"/>
          <elementRef key="listEvent" source="tei:4.11.0"/>
          <elementRef key="event" source="tei:4.11.0"/>
          <elementRef key="eventName" source="tei:4.11.0"/>
          <elementRef key="place" source="tei:4.11.0"/>
          <elementRef key="country" source="tei:4.11.0"/>
          <elementRef key="region" source="tei:4.11.0"/>
          <!-- contenu d’une exposition : version souple, sans ordre imposé -->
          <elementSpec ident="event" mode="change" module="namesdates">
            <content>
              <alternate minOccurs="0" maxOccurs="unbounded">
                <elementRef key="eventName"/>
                <elementRef key="place"/>
                <elementRef key="date"/>
                <elementRef key="idno"/>
                <elementRef key="note"/>
              </alternate>
            </content>
          </elementSpec>
          <!-- lieu d’une exposition : version souple, sans ordre imposé -->
          <elementSpec ident="place" mode="change" module="namesdates">
            <content>
              <alternate minOccurs="0" maxOccurs="unbounded">
                <elementRef key="orgName"/>
                <elementRef key="placeName"/>
                <elementRef key="country"/>
                <elementRef key="region"/>
                <elementRef key="idno"/>
                <elementRef key="note"/>
              </alternate>
            </content>
          </elementSpec>
        </schemaSpec>
      </div>
    </body>
  </text>
</TEI>
