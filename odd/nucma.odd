  <text>
    <front>
      <div>
        <head>Schéma pour NUCMA, l’encyclopédie Des nouveaux usages des collections dans les musées d’art</head>
        <p>TEI commons publishing</p>
        <p>https://git.unicaen.fr/fnso/i-fair-ir/tei-commons-publishing</p>
        <p>https://tei-commons-publishing.readthedocs.io</p>
      </div>
    </front>
    <body>
      <div>
        <head>Personnalisation du schéma de Commons Publishing OpenEdition pour le projet NUCMA</head>
        <schemaSpec ident="nucma.schema" start="TEI" source="../../tei-commons-publishing/odd/commons-publishing-metopes-compiled.odd">
          <moduleRef key="tei"/>
          <moduleRef key="header" except="title"/>
          <moduleRef key="core" except="biblStruct"/>
          <moduleRef key="textstructure"/>
          <moduleRef key="linking"/>
          <moduleRef key="namesdates"/>
          <moduleRef key="verse"/>
          <moduleRef key="figures"/>
          <moduleRef key="tagdocs"/>
          <moduleRef key="dictionaries"/>
          
          <elementRef key="emph" source="tei:4.11.0"/>
          <elementRef key="foreign" source="tei:4.11.0"/>
          <elementRef key="q" source="tei:4.11.0"/>
          <elementRef key="soCalled" source="tei:4.11.0"/>
          <elementRef key="title" source="tei:4.11.0"/>
          <!--<specGrpRef target="objects"/>
          <specGrpRef target="persons"/>
          <specGrpRef target="biblio"/>-->
        </schemaSpec>
      </div>
      <div>
        <head>Adaptations diverses</head>
        <specGrp xml:id="miscellaneous">
          <elementRef key="emph" source="tei:4.11.0"/>
          <elementRef key="foreign" source="tei:4.11.0"/>
          <elementRef key="q" source="tei:4.11.0"/>
          <elementRef key="soCalled" source="tei:4.11.0"/>
          <elementRef key="title" source="tei:4.11.0"/>
        </specGrp>
      </div>
    </body>
  </text>
</TEI>
