          </licence>
        </availability>
      </publicationStmt>
      <sourceDesc>
        <p>Fichier nativement numérique</p>
      </sourceDesc>
    </fileDesc>
    <revisionDesc>
      <change when="2026-10-04" who="#ECD">Création</change>
    </revisionDesc>
  </teiHeader>
  <text>
    <body>
      <div>
        <head>Référentiel des œuvres</head>
        <p>Ce schéma contrôle <code>meta/artworks.xml</code>. Il s’appuie sur l’étage commun
          du projet (<code>nucma-common.odd</code>) et y ajoute la liste des œuvres, reprise de
          la TEI. Première version, souple : une œuvre réunit son titre
          (<gi>objectName</gi>), ses auteurs (<gi>author</gi>, avec <att>ref</att> vers
          <code>meta/names.xml</code>) et ses identifiants, sans ordre imposé.</p>
        <schemaSpec ident="nucma-artworks" start="TEI" source="nucma-common.compiled.odd">
          <moduleRef key="tei"/>
          <moduleRef key="header" except="title"/>
          <moduleRef key="core"/>
          <moduleRef key="textstructure"/>
          <moduleRef key="linking"/>
          <moduleRef key="namesdates"/>
          <moduleRef key="verse"/>
          <moduleRef key="figures"/>
          <moduleRef key="tagdocs"/>
          <moduleRef key="dictionaries"/>
          <!-- classe des objets, absente de Commons Publishing : sans elle, listObject ne peut
               contenir d’object -->
          <classSpec ident="model.objectLike" type="model" mode="add"/>
          <elementRef key="listObject" source="tei:4.11.0"/>
          <elementRef key="object" source="tei:4.11.0"/>
          <!-- contenu d’une œuvre : version souple, sans ordre imposé -->
          <elementSpec ident="object" mode="change" module="namesdates">
            <content>
              <alternate minOccurs="0" maxOccurs="unbounded">
                <elementRef key="objectName"/>
                <elementRef key="author"/>
                <elementRef key="idno"/>
                <elementRef key="note"/>
              </alternate>
            </content>
          </elementSpec>
        </schemaSpec>
      </div>
    </body>
  </text>
</TEI>
