<?xml version="1.0" encoding="UTF-8"?>
<?xml-model href="http://www.tei-c.org/release/xml/tei/custom/schema/relaxng/tei_odds.rng" type="application/xml" schematypens="http://relaxng.org/ns/structure/1.0"?>
<TEI xmlns="http://www.tei-c.org/ns/1.0" xml:lang="fr">
  <teiHeader>
    <fileDesc>
      <titleStmt>
        <title>NUCMA : schéma du référentiel des médias</title>
        <principal ref="#ECD">Emmanuel Château-Dutier</principal>
      </titleStmt>
      <publicationStmt>
        <publisher xml:lang="fr">Groupe de recherche et de réflexion CIÉCO</publisher>
        <publisher xml:lang="en">CIÉCO Research and Inquiry Group</publisher>
        <availability>
          <licence target="https://creativecommons.org/licenses/by/4.0/">
            <p>Ce contenu est mis à disposition sous licence Creative Commons Attribution 4.0</p>
          </licence>
        </availability>
      </publicationStmt>
      <sourceDesc>
        <p>Fichier nativement numérique</p>
      </sourceDesc>
    </fileDesc>
    <revisionDesc>
      <change when="2026-10-04" who="#ECD">Création</change>
      <change when="2026-10-16" who="#ECD">Ajout de <att>mimeType</att> sur <gi>graphic</gi> (classe att.internetMedia)</change>
    </revisionDesc>
  </teiHeader>
  <text>
    <body>
      <div>
        <head>Référentiel des médias</head>
        <p>Ce schéma contrôle <code>meta/medias.xml</code>. Il s’appuie sur l’étage commun
          du projet (<code>nucma-common.odd</code>). Le référentiel est encore embryonnaire :
          ce schéma reprend pour l’instant les règles communes, en attendant que sa structure
          soit fixée.</p>
        <p>Le type de média est indiqué par <att>mimeType</att> sur <gi>graphic</gi>
          (<code>&lt;graphic url="images/image01.jpg" mimeType="image/*"/&gt;</code>). La
          classe <ident type="class">att.internetMedia</ident>, absente de Commons Publishing,
          est reprise de la TEI. Pour l’instant, la liste fermée ne propose que deux valeurs
          génériques : <code>image/*</code> et <code>video/*</code>. <att>url</att> et
          <att>mimeType</att> sont obligatoires sur <gi>graphic</gi>.</p>
        <schemaSpec ident="nucma-medias" start="TEI" source="nucma-common.compiled.odd">
          <moduleRef key="tei"/>
          <moduleRef key="header" except="title"/>
          <moduleRef key="core" except="biblStruct"/>
          <moduleRef key="textstructure"/>
          <moduleRef key="linking"/>
          <moduleRef key="namesdates"/>
          <moduleRef key="verse"/>
          <moduleRef key="figures"/>
          <moduleRef key="tagdocs"/>
          <moduleRef key="dictionaries"/>

          <!-- type de média (@mimeType) : classe absente de Commons Publishing -->
          <classRef key="att.internetMedia" source="tei:4.11.0"/>
          <classSpec ident="att.internetMedia" type="atts" mode="change" module="tei">
            <attList>
              <attDef ident="mimeType" mode="change">
                <valList mode="replace" type="closed">
                  <valItem ident="image/*"><desc>image</desc></valItem>
                  <valItem ident="video/*"><desc>vidéo</desc></valItem>
                </valList>
              </attDef>
            </attList>
          </classSpec>
          <elementSpec ident="graphic" mode="change" module="core">
            <classes mode="change"><memberOf key="att.internetMedia" mode="add"/></classes>
            <!-- @url (att.resourced) est déjà obligatoire -->
            <attList>
              <attDef ident="mimeType" mode="change" usage="req"/>
            </attList>
          </elementSpec>
        </schemaSpec>
      </div>
    </body>
  </text>
</TEI>
