<?xml version="1.0" encoding="UTF-8"?>
<?xml-model href="http://www.tei-c.org/release/xml/tei/custom/schema/relaxng/tei_odds.rng" type="application/xml" schematypens="http://relaxng.org/ns/structure/1.0"?>
<TEI xmlns="http://www.tei-c.org/ns/1.0" xml:lang="fr">
  <teiHeader>
    <fileDesc>
      <titleStmt>
        <title>NUCMA : schéma du référentiel bibliographique</title>
        <principal ref="#ECD">
          <persName><forename>Emmanuel</forename> <surname>Château-Dutier</surname></persName>
          <affiliation>Université de Montréal</affiliation>
        </principal>
      </titleStmt>
      <publicationStmt>
        <publisher xml:lang="fr">Groupe de recherche et de réflexion CIÉCO</publisher>
        <publisher xml:lang="en">CIÉCO Research and Inquiry Group</publisher>
        <availability>
          <licence target="https://creativecommons.org/licenses/by/4.0/">
            <p>Ce contenu est mis à disposition sous licence Creative Commons Attribution 4.0</p>
          </licence>
        </availability>
      </publicationStmt>
      <sourceDesc>
        <p>Fichier nativement numérique</p>
      </sourceDesc>
    </fileDesc>
    <revisionDesc>
      <change when="2026-10-04" resp="#ECD">Création</change>
    </revisionDesc>
  </teiHeader>
  <text>
    <body>
      <div>
        <head>Référentiel bibliographique</head>
        <p>Ce schéma contrôle <code>meta/bibliography.xml</code>. Il s’appuie sur l’étage
          commun du projet (<code>nucma-common.odd</code>) et y rétablit la bibliographie
          structurée (<gi>biblStruct</gi>), que l’étage commun exclut des entrées. Première
          version, souple : les modèles de contenu de Commons Publishing sont conservés.</p>
        <schemaSpec ident="nucma-bibliography" start="TEI" source="nucma-common.compiled.odd">
          <moduleRef key="tei"/>
          <moduleRef key="header" except="title"/>
          <moduleRef key="core"/>
          <moduleRef key="textstructure"/>
          <moduleRef key="linking"/>
          <moduleRef key="namesdates"/>
          <moduleRef key="verse"/>
          <moduleRef key="figures"/>
          <moduleRef key="tagdocs"/>
          <moduleRef key="dictionaries"/>

          <!-- bibliographie structurée : exclue par l’étage commun, reprise de la TEI -->
          <elementRef key="biblStruct" source="tei:4.11.0"/>
          <!-- lien de chaque référence vers sa notice dans la bibliothèque Zotero du projet -->
          <elementSpec ident="biblStruct" mode="change" module="core">
            <attList>
              <attDef ident="corresp" mode="add" usage="opt">
                <datatype maxOccurs="unbounded"><dataRef key="teidata.pointer"/></datatype>
              </attDef>
            </attList>
          </elementSpec>

          <!-- @todo PROVISOIRE : valeurs produites par l’export TEI de Zotero, admises pour
               que meta/bibliography.xml valide tel qu’exporté. À corriger plus tard, puis
               retirer ces deux déclarations :
               - idno/@type en capitales (DOI, ISBN, ISSN, URI) → doi, isbn, issn, uri,
                 la liste fermée de l’étage commun ; le en-tête de bibliography.xml emploie
                 aussi type="URI", accepté ici par la même occasion ;
               - note/@type accessed (date de consultation), url, thesisType, absents de
                 Commons Publishing → choisir un encodage (date de consultation, ptr ou
                 idno type="url", type de thèse) et l’appliquer à l’export. -->
          <elementSpec ident="idno" mode="change" module="header">
            <attList>
              <attDef ident="type" mode="change">
                <valList mode="change" type="closed">
                  <valItem mode="add" ident="DOI"><desc>export Zotero (provisoire : doi)</desc></valItem>
                  <valItem mode="add" ident="ISBN"><desc>export Zotero (provisoire : isbn)</desc></valItem>
                  <valItem mode="add" ident="ISSN"><desc>export Zotero (provisoire : issn)</desc></valItem>
                  <valItem mode="add" ident="URI"><desc>export Zotero (provisoire : uri)</desc></valItem>
                </valList>
              </attDef>
            </attList>
          </elementSpec>
          <elementSpec ident="note" mode="change" module="core">
            <attList>
              <attDef ident="type" mode="change">
                <valList mode="change" type="closed">
                  <valItem mode="add" ident="accessed"><desc>export Zotero : date de consultation (provisoire)</desc></valItem>
                  <valItem mode="add" ident="url"><desc>export Zotero : adresse de la ressource (provisoire)</desc></valItem>
                  <valItem mode="add" ident="thesisType"><desc>export Zotero : type de thèse (provisoire)</desc></valItem>
                </valList>
              </attDef>
            </attList>
          </elementSpec>
        </schemaSpec>
      </div>
    </body>
  </text>
</TEI>
