<?xml version="1.0" encoding="UTF-8"?>
<x:description xmlns:x="http://www.jenitennison.com/xslt/xspec"
  xmlns:nucma="https://nucma.ca/ns"
  xmlns:tei="http://www.tei-c.org/ns/1.0"
  stylesheet="../normalization.xsl" xslt-version="3.0">
  <!-- Tests de xsl/normalization.xsl.
       Les fonctions sont testées sans document : la langue par défaut est fixée ici, et le
       rapport et le journal sont désactivés. Chaque règle sur une chaîne est aussi testée pour
       l’idempotence : appliquée une seconde fois, elle ne change plus rien.
       Les valeurs attendues ont été calculées avec la feuille, puis relues. -->
  <x:param name="default-lang" select="'fr'"/>
  <x:param name="report" select="'none'"/>
  <x:param name="log-dir" select="''"/>

  <x:scenario label="Espaces (français)">
    <x:scenario label="espace fine insécable avant ?">
      <x:call function="nucma:spacing-fr">
        <x:param select="'Bonjour ?'"/>
        <x:param select="false()"/>
      </x:call>
      <x:expect label="résultat" select="'Bonjour&#x202F;?'"/>
      <x:expect label="idempotent" test="nucma:spacing-fr($x:result, false()) eq $x:result"/>
    </x:scenario>
    <x:scenario label="espace ajoutée avant ? quand elle manque">
      <x:call function="nucma:spacing-fr">
        <x:param select="'Bonjour?'"/>
        <x:param select="false()"/>
      </x:call>
      <x:expect label="résultat" select="'Bonjour&#x202F;?'"/>
      <x:expect label="idempotent" test="nucma:spacing-fr($x:result, false()) eq $x:result"/>
    </x:scenario>
    <x:scenario label="espace fine avant ; remplacée">
      <x:call function="nucma:spacing-fr">
        <x:param select="'un&#x2009;; deux'"/>
        <x:param select="false()"/>
      </x:call>
      <x:expect label="résultat" select="'un&#x202F;; deux'"/>
      <x:expect label="idempotent" test="nucma:spacing-fr($x:result, false()) eq $x:result"/>
    </x:scenario>
    <x:scenario label="espace insécable avant :">
      <x:call function="nucma:spacing-fr">
        <x:param select="'Attention : voici'"/>
        <x:param select="false()"/>
      </x:call>
      <x:expect label="résultat" select="'Attention&#xA0;: voici'"/>
      <x:expect label="idempotent" test="nucma:spacing-fr($x:result, false()) eq $x:result"/>
    </x:scenario>
    <x:scenario label="deux-points entre chiffres inchangé">
      <x:call function="nucma:spacing-fr">
        <x:param select="'Il est 21:24.'"/>
        <x:param select="false()"/>
      </x:call>
      <x:expect label="résultat" select="'Il est 21:24.'"/>
      <x:expect label="idempotent" test="nucma:spacing-fr($x:result, false()) eq $x:result"/>
    </x:scenario>
    <x:scenario label="espace insécable dans les guillemets">
      <x:call function="nucma:spacing-fr">
        <x:param select="'« mot »'"/>
        <x:param select="false()"/>
      </x:call>
      <x:expect label="résultat" select="'«&#xA0;mot&#xA0;»'"/>
      <x:expect label="idempotent" test="nucma:spacing-fr($x:result, false()) eq $x:result"/>
    </x:scenario>
    <x:scenario label="espace ajoutée après la ponctuation">
      <x:call function="nucma:spacing-fr">
        <x:param select="'encodeuses:Ajouter'"/>
        <x:param select="false()"/>
      </x:call>
      <x:expect label="résultat" select="'encodeuses&#xA0;: Ajouter'"/>
      <x:expect label="idempotent" test="nucma:spacing-fr($x:result, false()) eq $x:result"/>
    </x:scenario>
    <x:scenario label="?! reste groupé">
      <x:call function="nucma:spacing-fr">
        <x:param select="'Quoi ?!'"/>
        <x:param select="false()"/>
      </x:call>
      <x:expect label="résultat" select="'Quoi&#x202F;?!'"/>
      <x:expect label="idempotent" test="nucma:spacing-fr($x:result, false()) eq $x:result"/>
    </x:scenario>
    <x:scenario label="ponctuation en début de nœud, après un élément">
      <x:call function="nucma:spacing-fr">
        <x:param select="'? Suite'"/>
        <x:param select="true()"/>
      </x:call>
      <x:expect label="résultat" select="'&#x202F;? Suite'"/>
      <x:expect label="idempotent" test="nucma:spacing-fr($x:result, true()) eq $x:result"/>
    </x:scenario>
  </x:scenario>

  <x:scenario label="Espaces (anglais)">
    <x:scenario label="pas d’espace avant ?">
      <x:call function="nucma:spacing-en">
        <x:param select="'Really ?'"/>
      </x:call>
      <x:expect label="résultat" select="'Really?'"/>
      <x:expect label="idempotent" test="nucma:spacing-en($x:result) eq $x:result"/>
    </x:scenario>
    <x:scenario label="pas d’espace avant :">
      <x:call function="nucma:spacing-en">
        <x:param select="'Note : here'"/>
      </x:call>
      <x:expect label="résultat" select="'Note: here'"/>
      <x:expect label="idempotent" test="nucma:spacing-en($x:result) eq $x:result"/>
    </x:scenario>
    <x:scenario label="espace ajoutée après ;">
      <x:call function="nucma:spacing-en">
        <x:param select="'one;two'"/>
      </x:call>
      <x:expect label="résultat" select="'one; two'"/>
      <x:expect label="idempotent" test="nucma:spacing-en($x:result) eq $x:result"/>
    </x:scenario>
    <x:scenario label="virgule et point dans les guillemets">
      <x:call function="nucma:spacing-en">
        <x:param select="'“hello”, he said “bye”.'"/>
      </x:call>
      <x:expect label="résultat" select="'“hello,” he said “bye.”'"/>
      <x:expect label="idempotent" test="nucma:spacing-en($x:result) eq $x:result"/>
    </x:scenario>
    <x:scenario label="apostrophe finale non déplacée">
      <x:call function="nucma:spacing-en">
        <x:param select="'the artists’.'"/>
      </x:call>
      <x:expect label="résultat" select="'the artists’.'"/>
      <x:expect label="idempotent" test="nucma:spacing-en($x:result) eq $x:result"/>
    </x:scenario>
  </x:scenario>

  <x:scenario label="Apostrophes">
    <x:scenario label="élisions françaises">
      <x:call function="nucma:apostrophes">
        <x:param select="'l''art d''aujourd''hui'"/>
        <x:param select="'fr'"/>
        <x:param select="false()"/>
      </x:call>
      <x:expect label="résultat" select="'l’art d’aujourd’hui'"/>
      <x:expect label="idempotent" test="nucma:apostrophes($x:result, 'fr', false()) eq $x:result"/>
    </x:scenario>
    <x:scenario label="caractères mal employés">
      <x:call function="nucma:apostrophes">
        <x:param select="'l‘œuvre, l´art'"/>
        <x:param select="'fr'"/>
        <x:param select="false()"/>
      </x:call>
      <x:expect label="résultat" select="'l’œuvre, l’art'"/>
      <x:expect label="idempotent" test="nucma:apostrophes($x:result, 'fr', false()) eq $x:result"/>
    </x:scenario>
    <x:scenario label="guillemet ouvrant français non touché">
      <x:call function="nucma:apostrophes">
        <x:param select="'un ''mot'"/>
        <x:param select="'fr'"/>
        <x:param select="false()"/>
      </x:call>
      <x:expect label="résultat" select="'un ''mot'"/>
      <x:expect label="idempotent" test="nucma:apostrophes($x:result, 'fr', false()) eq $x:result"/>
    </x:scenario>
    <x:scenario label="anglais : possessif, décennie, guillemets simples">
      <x:call function="nucma:apostrophes">
        <x:param select="'It''s the ''60s, Kurt''s ''Merzbau'''"/>
        <x:param select="'en'"/>
        <x:param select="false()"/>
      </x:call>
      <x:expect label="résultat" select="'It’s the ’60s, Kurt’s ‘Merzbau’'"/>
      <x:expect label="idempotent" test="nucma:apostrophes($x:result, 'en', false()) eq $x:result"/>
    </x:scenario>
    <x:scenario label="anglais : possessif après un élément">
      <x:call function="nucma:apostrophes">
        <x:param select="'''s Trio A'"/>
        <x:param select="'en'"/>
        <x:param select="true()"/>
      </x:call>
      <x:expect label="résultat" select="'’s Trio A'"/>
      <x:expect label="idempotent" test="nucma:apostrophes($x:result, 'en', true()) eq $x:result"/>
    </x:scenario>
  </x:scenario>

  <x:scenario label="Ligature œ">
    <x:scenario label="racines usuelles et casse">
      <x:call function="nucma:ligatures-fr">
        <x:param select="'oeuvre, coeur, Oeuvre, OEUVRE, soeur, boeuf'"/>
      </x:call>
      <x:expect label="résultat" select="'œuvre, cœur, Œuvre, ŒUVRE, sœur, bœuf'"/>
      <x:expect label="idempotent" test="nucma:ligatures-fr($x:result) eq $x:result"/>
    </x:scenario>
    <x:scenario label="mots qui gardent oe">
      <x:call function="nucma:ligatures-fr">
        <x:param select="'coefficient, coexister, moelle, Noël, goéland'"/>
      </x:call>
      <x:expect label="résultat" select="'coefficient, coexister, moelle, Noël, goéland'"/>
      <x:expect label="idempotent" test="nucma:ligatures-fr($x:result) eq $x:result"/>
    </x:scenario>
  </x:scenario>

  <x:scenario label="Abréviations">
    <x:scenario label="renvois">
      <x:call function="nucma:abbreviations">
        <x:param select="'p.12, fig. 1, vol. 3, n° 16, art. 5'"/>
        <x:param select="'fr'"/>
      </x:call>
      <x:expect label="résultat" select="'p.&#xA0;12, fig.&#xA0;1, vol.&#xA0;3, n°&#xA0;16, art.&#xA0;5'"/>
      <x:expect label="idempotent" test="nucma:abbreviations($x:result, 'fr') eq $x:result"/>
    </x:scenario>
    <x:scenario label="tome en chiffres romains">
      <x:call function="nucma:abbreviations">
        <x:param select="'t. II, chap. XII, t. Il'"/>
        <x:param select="'fr'"/>
      </x:call>
      <x:expect label="résultat" select="'t.&#xA0;II, chap.&#xA0;XII, t. Il'"/>
      <x:expect label="idempotent" test="nucma:abbreviations($x:result, 'fr') eq $x:result"/>
    </x:scenario>
    <x:scenario label="titres de civilité (français)">
      <x:call function="nucma:abbreviations">
        <x:param select="'M. Dupont, Mme Martin, M. le maire'"/>
        <x:param select="'fr'"/>
      </x:call>
      <x:expect label="résultat" select="'M.&#xA0;Dupont, Mme&#xA0;Martin, M. le maire'"/>
      <x:expect label="idempotent" test="nucma:abbreviations($x:result, 'fr') eq $x:result"/>
    </x:scenario>
    <x:scenario label="titres de civilité (anglais)">
      <x:call function="nucma:abbreviations">
        <x:param select="'Mr. Smith, Dr Brown, Me Too'"/>
        <x:param select="'en'"/>
      </x:call>
      <x:expect label="résultat" select="'Mr.&#xA0;Smith, Dr&#xA0;Brown, Me Too'"/>
      <x:expect label="idempotent" test="nucma:abbreviations($x:result, 'en') eq $x:result"/>
    </x:scenario>
  </x:scenario>

  <x:scenario label="Nombres">
    <x:scenario label="milliers (français)">
      <x:call function="nucma:numbers">
        <x:param select="'10 000 œuvres, 10.000 visiteurs'"/>
        <x:param select="'fr'"/>
      </x:call>
      <x:expect label="résultat" select="'10&#x202F;000 œuvres, 10&#x202F;000 visiteurs'"/>
      <x:expect label="idempotent" test="nucma:numbers($x:result, 'fr') eq $x:result"/>
    </x:scenario>
    <x:scenario label="suites de chiffres non regroupées">
      <x:call function="nucma:numbers">
        <x:param select="'514 987 3000, en 1914 250, 3.5, 2.0.1'"/>
        <x:param select="'fr'"/>
      </x:call>
      <x:expect label="résultat" select="'514 987 3000, en 1914 250, 3.5, 2.0.1'"/>
      <x:expect label="idempotent" test="nucma:numbers($x:result, 'fr') eq $x:result"/>
    </x:scenario>
    <x:scenario label="intervalles">
      <x:call function="nucma:numbers">
        <x:param select="'1914-1918, 68 - 77, 1939—1945, 1 000-2 000'"/>
        <x:param select="'fr'"/>
      </x:call>
      <x:expect label="résultat" select="'1914–1918, 68–77, 1939–1945, 1&#x202F;000–2&#x202F;000'"/>
      <x:expect label="idempotent" test="nucma:numbers($x:result, 'fr') eq $x:result"/>
    </x:scenario>
    <x:scenario label="chaînes et codes non touchés">
      <x:call function="nucma:numbers">
        <x:param select="'2026-01-20, 978-2-07-036822-8, COVID-19, A4-5, 1,5-2,5'"/>
        <x:param select="'fr'"/>
      </x:call>
      <x:expect label="résultat" select="'2026-01-20, 978-2-07-036822-8, COVID-19, A4-5, 1,5-2,5'"/>
      <x:expect label="idempotent" test="nucma:numbers($x:result, 'fr') eq $x:result"/>
    </x:scenario>
    <x:scenario label="unités">
      <x:call function="nucma:numbers">
        <x:param select="'12cm, 3 m, 20 °C, 1980s, 4K, 3 mois'"/>
        <x:param select="'fr'"/>
      </x:call>
      <x:expect label="résultat" select="'12&#xA0;cm, 3&#xA0;m, 20&#xA0;°C, 1980s, 4K, 3 mois'"/>
      <x:expect label="idempotent" test="nucma:numbers($x:result, 'fr') eq $x:result"/>
    </x:scenario>
    <x:scenario label="pourcentage et monnaie (français)">
      <x:call function="nucma:numbers">
        <x:param select="'50%, 10€'"/>
        <x:param select="'fr'"/>
      </x:call>
      <x:expect label="résultat" select="'50&#xA0;%, 10&#xA0;€'"/>
      <x:expect label="idempotent" test="nucma:numbers($x:result, 'fr') eq $x:result"/>
    </x:scenario>
    <x:scenario label="heures (français)">
      <x:call function="nucma:numbers">
        <x:param select="'10h30, 10h, 9h-17h, 1914h'"/>
        <x:param select="'fr'"/>
      </x:call>
      <x:expect label="résultat" select="'10&#xA0;h&#xA0;30, 10&#xA0;h, 9&#xA0;h–17&#xA0;h, 1914h'"/>
      <x:expect label="idempotent" test="nucma:numbers($x:result, 'fr') eq $x:result"/>
    </x:scenario>
    <x:scenario label="anglais : milliers, pourcentage, monnaie">
      <x:call function="nucma:numbers">
        <x:param select="'10 000, 50 %, 10 €, 10 $ CA'"/>
        <x:param select="'en'"/>
      </x:call>
      <x:expect label="résultat" select="'10,000, 50%, €10, CA$10'"/>
      <x:expect label="idempotent" test="nucma:numbers($x:result, 'en') eq $x:result"/>
    </x:scenario>
    <x:scenario label="anglais : heures">
      <x:call function="nucma:numbers">
        <x:param select="'10 h 30, 10 am, 5 PM'"/>
        <x:param select="'en'"/>
      </x:call>
      <x:expect label="résultat" select="'10:30, 10&#xA0;a.m., 5&#xA0;p.m.'"/>
      <x:expect label="idempotent" test="nucma:numbers($x:result, 'en') eq $x:result"/>
    </x:scenario>
  </x:scenario>

  <x:scenario label="Ponctuation">
    <x:scenario label="tirets d’incise (français)">
      <x:call function="nucma:punctuation">
        <x:param select="'mot - incise - suite, et -- double'"/>
        <x:param select="'fr'"/>
        <x:param select="false()"/>
      </x:call>
      <x:expect label="résultat" select="'mot&#xA0;– incise&#xA0;– suite, et&#xA0;– double'"/>
      <x:expect label="idempotent" test="nucma:punctuation($x:result, 'fr', false()) eq $x:result"/>
    </x:scenario>
    <x:scenario label="points de suspension">
      <x:call function="nucma:punctuation">
        <x:param select="'etc... attendez... (...)'"/>
        <x:param select="'fr'"/>
        <x:param select="false()"/>
      </x:call>
      <x:expect label="résultat" select="'etc. attendez… […]'"/>
      <x:expect label="idempotent" test="nucma:punctuation($x:result, 'fr', false()) eq $x:result"/>
    </x:scenario>
    <x:scenario label="tirets (anglais, Chicago)">
      <x:call function="nucma:punctuation">
        <x:param select="'word - word, word--word, kept – dash'"/>
        <x:param select="'en'"/>
        <x:param select="false()"/>
      </x:call>
      <x:expect label="résultat" select="'word—word, word—word, kept – dash'"/>
      <x:expect label="idempotent" test="nucma:punctuation($x:result, 'en', false()) eq $x:result"/>
    </x:scenario>
    <x:scenario label="anglais : n° devient no.">
      <x:call function="nucma:punctuation">
        <x:param select="'n° 4'"/>
        <x:param select="'en'"/>
        <x:param select="false()"/>
      </x:call>
      <x:expect label="résultat" select="'no. 4'"/>
      <x:expect label="idempotent" test="nucma:punctuation($x:result, 'en', false()) eq $x:result"/>
    </x:scenario>
  </x:scenario>

  <x:scenario label="Guillemets">
    <x:scenario label="français : premier et second niveaux">
      <x:call function="nucma:quotes">
        <x:param select="'&quot;il a écrit &quot;Trio A&quot; hier&quot;'"/>
        <x:param select="'fr'"/>
        <x:param select="0"/>
        <x:param select="false()"/>
        <x:param select="false()"/>
      </x:call>
      <x:expect label="résultat" test="$x:result?text eq '«il a écrit “Trio A” hier»'"/>
      <x:expect label="idempotent" test="nucma:quotes($x:result?text, 'fr', 0, false(), false())?text eq $x:result?text"/>
    </x:scenario>
    <x:scenario label="français : “ ” de premier niveau devient « »">
      <x:call function="nucma:quotes">
        <x:param select="'“Modern Art”'"/>
        <x:param select="'fr'"/>
        <x:param select="0"/>
        <x:param select="false()"/>
        <x:param select="false()"/>
      </x:call>
      <x:expect label="résultat" test="$x:result?text eq '«Modern Art»'"/>
      <x:expect label="idempotent" test="nucma:quotes($x:result?text, 'fr', 0, false(), false())?text eq $x:result?text"/>
    </x:scenario>
    <x:scenario label="anglais : premier et second niveaux">
      <x:call function="nucma:quotes">
        <x:param select="'&quot;she said &quot;hi&quot; today&quot;'"/>
        <x:param select="'en'"/>
        <x:param select="0"/>
        <x:param select="false()"/>
        <x:param select="false()"/>
      </x:call>
      <x:expect label="résultat" test="$x:result?text eq '“she said ‘hi’ today”'"/>
      <x:expect label="idempotent" test="nucma:quotes($x:result?text, 'en', 0, false(), false())?text eq $x:result?text"/>
    </x:scenario>
    <x:scenario label="anglais : guillemets français convertis">
      <x:call function="nucma:quotes">
        <x:param select="'&quot;the «variable» artwork&quot;'"/>
        <x:param select="'en'"/>
        <x:param select="0"/>
        <x:param select="false()"/>
        <x:param select="false()"/>
      </x:call>
      <x:expect label="résultat" test="$x:result?text eq '“the ‘variable’ artwork”'"/>
      <x:expect label="idempotent" test="nucma:quotes($x:result?text, 'en', 0, false(), false())?text eq $x:result?text"/>
    </x:scenario>
  </x:scenario>

  <x:scenario label="Ordinaux (français)">
    <x:scenario label="siècle en petites capitales">
      <x:call function="nucma:ordinals-fr">
        <x:param select="'Au XVIIIe siècle'"/>
      </x:call>
      <x:expect label="résultat" test="string-join($x:result ! serialize(.)) eq 'Au &lt;hi xmlns=&quot;http://www.tei-c.org/ns/1.0&quot; rend=&quot;smallcaps&quot;&gt;xviii&lt;/hi&gt;&lt;hi xmlns=&quot;http://www.tei-c.org/ns/1.0&quot; rend=&quot;superscript&quot;&gt;e&lt;/hi&gt;&#xA0;siècle'"/>
    </x:scenario>
    <x:scenario label="chiffres arabes convertis en romains">
      <x:call function="nucma:ordinals-fr">
        <x:param select="'le 20e siècle'"/>
      </x:call>
      <x:expect label="résultat" test="string-join($x:result ! serialize(.)) eq 'le &lt;hi xmlns=&quot;http://www.tei-c.org/ns/1.0&quot; rend=&quot;smallcaps&quot;&gt;xx&lt;/hi&gt;&lt;hi xmlns=&quot;http://www.tei-c.org/ns/1.0&quot; rend=&quot;superscript&quot;&gt;e&lt;/hi&gt;&#xA0;siècle'"/>
    </x:scenario>
    <x:scenario label="suite de siècles">
      <x:call function="nucma:ordinals-fr">
        <x:param select="'les XIXe-XXe siècles'"/>
      </x:call>
      <x:expect label="résultat" test="string-join($x:result ! serialize(.)) eq 'les &lt;hi xmlns=&quot;http://www.tei-c.org/ns/1.0&quot; rend=&quot;smallcaps&quot;&gt;xix&lt;/hi&gt;&lt;hi xmlns=&quot;http://www.tei-c.org/ns/1.0&quot; rend=&quot;superscript&quot;&gt;e&lt;/hi&gt;-&lt;hi xmlns=&quot;http://www.tei-c.org/ns/1.0&quot; rend=&quot;smallcaps&quot;&gt;xx&lt;/hi&gt;&lt;hi xmlns=&quot;http://www.tei-c.org/ns/1.0&quot; rend=&quot;superscript&quot;&gt;e&lt;/hi&gt;&#xA0;siècles'"/>
    </x:scenario>
    <x:scenario label="formes ème, ᵉ, Ier">
      <x:call function="nucma:ordinals-fr">
        <x:param select="'XVIIIème siècle, XVIIIᵉ siècle, Ier siècle'"/>
      </x:call>
      <x:expect label="résultat" test="string-join($x:result ! serialize(.)) eq '&lt;hi xmlns=&quot;http://www.tei-c.org/ns/1.0&quot; rend=&quot;smallcaps&quot;&gt;xviii&lt;/hi&gt;&lt;hi xmlns=&quot;http://www.tei-c.org/ns/1.0&quot; rend=&quot;superscript&quot;&gt;e&lt;/hi&gt;&#xA0;siècle, &lt;hi xmlns=&quot;http://www.tei-c.org/ns/1.0&quot; rend=&quot;smallcaps&quot;&gt;xviii&lt;/hi&gt;&lt;hi xmlns=&quot;http://www.tei-c.org/ns/1.0&quot; rend=&quot;superscript&quot;&gt;e&lt;/hi&gt;&#xA0;siècle, &lt;hi xmlns=&quot;http://www.tei-c.org/ns/1.0&quot; rend=&quot;smallcaps&quot;&gt;i&lt;/hi&gt;&lt;hi xmlns=&quot;http://www.tei-c.org/ns/1.0&quot; rend=&quot;superscript&quot;&gt;er&lt;/hi&gt;&#xA0;siècle'"/>
    </x:scenario>
    <x:scenario label="ordinal hors siècle">
      <x:call function="nucma:ordinals-fr">
        <x:param select="'3e éd., la Ve République, 1re fois'"/>
      </x:call>
      <x:expect label="résultat" test="string-join($x:result ! serialize(.)) eq '3&lt;hi xmlns=&quot;http://www.tei-c.org/ns/1.0&quot; rend=&quot;superscript&quot;&gt;e&lt;/hi&gt; éd., la V&lt;hi xmlns=&quot;http://www.tei-c.org/ns/1.0&quot; rend=&quot;superscript&quot;&gt;e&lt;/hi&gt; République, 1&lt;hi xmlns=&quot;http://www.tei-c.org/ns/1.0&quot; rend=&quot;superscript&quot;&gt;re&lt;/hi&gt; fois'"/>
    </x:scenario>
    <x:scenario label="numéro">
      <x:call function="nucma:ordinals-fr">
        <x:param select="'n°&#xA0;16 et n°s 3'"/>
      </x:call>
      <x:expect label="résultat" test="string-join($x:result ! serialize(.)) eq 'n&lt;hi xmlns=&quot;http://www.tei-c.org/ns/1.0&quot; rend=&quot;superscript&quot;&gt;o&lt;/hi&gt;&#xA0;16 et n&lt;hi xmlns=&quot;http://www.tei-c.org/ns/1.0&quot; rend=&quot;superscript&quot;&gt;os&lt;/hi&gt; 3'"/>
    </x:scenario>
    <x:scenario label="pièges : Vers, Ce, Louis XIV, 3d, 21er">
      <x:call function="nucma:ordinals-fr">
        <x:param select="'Vers, Ce, Louis XIV, 3d, 21er'"/>
      </x:call>
      <x:expect label="résultat" test="string-join($x:result ! serialize(.)) eq 'Vers, Ce, Louis XIV, 3d, 21er'"/>
    </x:scenario>
  </x:scenario>

  <x:scenario label="Ordinaux (anglais)">
    <x:scenario label="suffixe calculé">
      <x:call function="nucma:ordinals-en">
        <x:param select="'1st, 2th, 3d, 11th, 21th, 22d, 101st'"/>
      </x:call>
      <x:expect label="résultat" test="string-join($x:result ! serialize(.)) eq '1st, 2nd, 3rd, 11th, 21st, 22nd, 101st'"/>
    </x:scenario>
    <x:scenario label="siècles : romains et formes françaises">
      <x:call function="nucma:ordinals-en">
        <x:param select="'the XVIIIth century, the XVIIIe century, 20e century'"/>
      </x:call>
      <x:expect label="résultat" test="string-join($x:result ! serialize(.)) eq 'the 18th century, the 18th century, 20th century'"/>
    </x:scenario>
    <x:scenario label="suite de siècles">
      <x:call function="nucma:ordinals-en">
        <x:param select="'from the 19th to the 21st century'"/>
      </x:call>
      <x:expect label="résultat" test="string-join($x:result ! serialize(.)) eq 'from the 19th to the 21st century'"/>
    </x:scenario>
    <x:scenario label="Louis XIV inchangé">
      <x:call function="nucma:ordinals-en">
        <x:param select="'Louis XIV, 3D'"/>
      </x:call>
      <x:expect label="résultat" test="string-join($x:result ! serialize(.)) eq 'Louis XIV, 3D'"/>
    </x:scenario>
  </x:scenario>

  <!-- Documents entiers : portée de la normalisation et langue -->
  <x:scenario label="Portée (normalization-scope.xml)">
    <x:context href="docs/normalization-scope.xml"/>
    <x:expect label="siècle replié depuis un exposant, URL et apostrophes" test="serialize(($x:result//tei:body//tei:p)[1]) eq '&lt;p xmlns=&quot;http://www.tei-c.org/ns/1.0&quot;&gt;Le &lt;hi rend=&quot;smallcaps&quot;&gt;xviii&lt;/hi&gt;&lt;hi rend=&quot;superscript&quot;&gt;e&lt;/hi&gt;&#xA0;siècle&#xA0;: voir https://ex.org/l''art?a=1&#x202F;; l’œuvre.&lt;/p&gt;'"/>
    <x:expect label="titre anglais balisé et latin épargnés" test="string(($x:result//tei:body//tei:p)[2]) eq 'Il cite Modern Art: Who Cares?&#x202F;; puis ad hoc ?'"/>
    <x:expect label="guillemets autour d’un élément" test="string(($x:result//tei:body//tei:p)[3]) eq 'Une citation «&#xA0;Vanitas&#xA0;» et «&#xA0;fin'"/>
    <x:expect label="bibliographie non traitée par défaut" test="string(($x:result//tei:div[@type = 'bibliography']/tei:p)[1]) eq 'Paris : Seuil, p. 12-25.'"/>
    <x:expect label="idno non traité" test="string(($x:result//tei:idno)[1]) eq '978-2-07-036822-8'"/>
  </x:scenario>

  <x:scenario label="Langue (normalization-english.xml)">
    <x:context href="docs/normalization-english.xml"/>
    <x:expect label="typographie anglaise d’après text/@xml:lang" test="string(($x:result//tei:body//tei:p)[1]) eq 'Is it the 18th century? “Yes,” the “variable” artwork.'"/>
  </x:scenario>
</x:description>
