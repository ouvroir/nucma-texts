<?xml version="1.0" encoding="UTF-8"?>
<x:description xmlns:x="http://www.jenitennison.com/xslt/xspec"
  xmlns:nucma="https://nucma.ca/ns"
  xmlns:tei="http://www.tei-c.org/ns/1.0"
  stylesheet="../nettoyage-import.xsl" xslt-version="3.0">
  <!-- Tests de xsl/nettoyage-import.xsl, sur des documents qui reproduisent les artefacts
       d’une conversion depuis Word. Le profil nucma des TEI Stylesheets
       (profile/docx/from.xsl) applique les mêmes règles : ces tests décrivent aussi le
       comportement attendu du profil.
       Les valeurs attendues ont été calculées avec la feuille, puis relues. -->

  <x:scenario label="Artefacts de Word (nettoyage-artefacts.xml)">
    <x:context href="docs/nettoyage-artefacts.xml"/>
    <x:expect label="styles, hi vides et xml:space" test="serialize(($x:result//tei:body//tei:p)[1]) eq '&lt;p xmlns=&quot;http://www.tei-c.org/ns/1.0&quot;&gt;Texte &lt;hi rend=&quot;italic&quot;&gt;italique&lt;/hi&gt; &lt;hi style=&quot;color:red&quot;&gt;rouge&lt;/hi&gt; fin .&lt;/p&gt;'"/>
    <x:expect label="seg vide réduit, ancre orpheline supprimée" test="serialize(($x:result//tei:body//tei:p)[2]) eq '&lt;p xmlns=&quot;http://www.tei-c.org/ns/1.0&quot;&gt;Appel&lt;ref target=&quot;#cible&quot;&gt;1&lt;/ref&gt; suite.&lt;/p&gt;'"/>
    <x:expect label="espaces insécables autour des éléments de phrase" test="serialize(($x:result//tei:body//tei:p)[3]) eq '&lt;p xmlns=&quot;http://www.tei-c.org/ns/1.0&quot;&gt;Le terme &lt;q&gt;garde négociée&lt;/q&gt; est proposé, et &lt;q&gt;achat conjoint&lt;/q&gt; ici, M.&#xA0;&lt;persName&gt;Dupont&lt;/persName&gt;.&lt;/p&gt;'"/>
    <x:expect label="liens : externe, nucma.ca, interne" test="serialize(($x:result//tei:body//tei:p)[4]) eq '&lt;p xmlns=&quot;http://www.tei-c.org/ns/1.0&quot;&gt;&lt;ref type=&quot;external&quot; target=&quot;https://www.moma.org/a&quot;&gt;MoMA&lt;/ref&gt; &lt;ref target=&quot;https://www.nucma.ca/fr/protocoles&quot;&gt;entrée&lt;/ref&gt; &lt;ref target=&quot;#cible&quot;&gt;interne&lt;/ref&gt;&lt;/p&gt;'"/>
    <x:expect label="attributs de graphic" test="serialize(($x:result//tei:graphic)[1]) eq '&lt;graphic xmlns=&quot;http://www.tei-c.org/ns/1.0&quot; url=&quot;media/image3.png&quot;/&gt;'"/>
    <x:expect label="intertitre vide supprimé, intertitre ciblé conservé" test="string-join($x:result//tei:head ! serialize(.), ' | ') eq '&lt;head xmlns=&quot;http://www.tei-c.org/ns/1.0&quot;&gt;&lt;anchor xml:id=&quot;cible&quot;/&gt;Titre ciblé&lt;/head&gt;'"/>
  </x:scenario>

  <x:scenario label="Commentaires (nettoyage-commentaires-notes.xml)">
    <x:context href="docs/nettoyage-commentaires-notes.xml"/>
    <x:expect label="commentaire de Word converti en @todo" test="string-join($x:result//comment() ! string(.), ' | ') eq ' @todo Aux encodeur·euses : ne pas oublier - - le lien Second paragraphe [Josée Desforges, 2026-05-25, sur « la pièce chorégraphique »] '"/>
    <x:expect label="ancres du commentaire supprimées" test="string(count($x:result//tei:anchor)) eq '0'"/>
  </x:scenario>

  <x:scenario label="Notes (nettoyage-commentaires-notes.xml)">
    <x:context href="docs/nettoyage-commentaires-notes.xml"/>
    <x:expect label="appels de note et renvoi mis à jour" test="serialize(($x:result//tei:body/tei:p)[2]) eq '&lt;p xmlns=&quot;http://www.tei-c.org/ns/1.0&quot;&gt;L’actualisation&lt;ref type=&quot;note&quot; target=&quot;#note01&quot;&gt;1&lt;/ref&gt; implique, et&lt;ref type=&quot;note&quot; target=&quot;#note02&quot;&gt;2&lt;/ref&gt; encore. Voir la &lt;ref target=&quot;#note01&quot;&gt;première note&lt;/ref&gt;.&lt;/p&gt;'"/>
    <x:expect label="back créé avec les notes en paragraphes" test="serialize(($x:result//tei:back)[1]) eq '&lt;back xmlns=&quot;http://www.tei-c.org/ns/1.0&quot;&gt;&lt;div type=&quot;notes&quot;&gt;&#10;&lt;note place=&quot;foot&quot; n=&quot;1&quot; xml:id=&quot;note01&quot;&gt; &lt;p&gt;Note en paragraphe.&lt;/p&gt;&lt;/note&gt;&#10;&lt;note place=&quot;foot&quot; n=&quot;2&quot; xml:id=&quot;note02&quot;&gt;&lt;p&gt;texte &lt;hi rend=&quot;italic&quot;&gt;en ligne&lt;/hi&gt;&lt;/p&gt;&lt;/note&gt;&#10;&lt;/div&gt;&lt;/back&gt;'"/>
  </x:scenario>

  <x:scenario label="Notes (nettoyage-notes-back.xml)">
    <x:context href="docs/nettoyage-notes-back.xml"/>
    <x:expect label="div des notes en tête d’un back existant" test="string-join(($x:result//tei:back/tei:div) ! (@type || ':' || normalize-space(.)), ' | ') eq 'notes:Une note. | bibliography:Référence.'"/>
  </x:scenario>
</x:description>
